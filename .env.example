# Jobyn landing page (Vite) environment variables.
# Copy to `.env` (local) or configure the matching keys in your hosting dashboard.

# Base URL of the Jobyn FastAPI backend.
# Defaults to http://127.0.0.1:8000 when unset (see src/lib/api.ts).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Firebase Web SDK configuration (Project settings -> Your apps -> Web app).
# All six values are required to enable Firebase Auth; when any is missing the
# app falls back to the legacy Jobyn token flow (see src/lib/firebase.ts).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
